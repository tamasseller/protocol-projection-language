{
  "private": true,
  "name": "ppl-monorepo",
  "version": "1.0.0",
  "description": "Declarative Serialization Compiler — monorepo root",
  "workspaces": [
    "packages/core",
    "packages/codecs",
    "packages/target-cpp",
    "packages/target-js"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:types": "npm run test:types --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
