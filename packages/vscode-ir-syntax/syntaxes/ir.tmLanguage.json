{
  "scopeName": "inline.ir-in-ts",
  "injectionSelector": "L:source.ts -string -comment, L:source.tsx -string -comment, L:source.js -string -comment, L:source.jsx -string -comment",
  "patterns": [
    {
      "begin": "\\b(ir)(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.ts" },
        "2": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "(`)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "contentName": "meta.embedded.block.c.ir-dsl",
      "patterns": [
        {
          "name": "meta.template.expression.ts",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.ts" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.ts" }
          },
          "patterns": [ { "include": "source.ts" } ]
        },
        { "include": "source.c" }
      ]
    }
  ]
}