{
  "name": "vscode-inline-ir",
  "displayName": "Inline IR Syntax Highlighting",
  "description": "Highlights C syntax inside ir`...` template literals",
  "version": "1.0.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/tamasseller/protocol-projection-language.git"
  },
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "build": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.32.0"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "inline.ir-in-ts",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx"
        ],
        "path": "./syntaxes/ir.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "meta.embedded.block.c.ir-dsl",
            "settings": {
              "fontStyle": "italic"
            }
          },
          {
            "scope": "meta.embedded.block.c.ir-dsl meta.template.expression.ts",
            "settings": {
              "fontStyle": ""
            }
          }
        ]
      }
    }
  }
}