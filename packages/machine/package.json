{
  "name": "@ppl/machine",
  "version": "1.0.0",
  "description": "Generic, protocol-agnostic bytecode compiler and VM (docs/isa-core.md) — IR authoring, lowering, whole-program validation, execution, and wire codec",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build:grammar": "peggy --format es -c pegconfig.json -o src/parser.js grammer.pegjs",
    "build": "npm run build:grammar && tsc",
    "test": "ts-node --project tsconfig.test.json test/run.ts",
    "test:types": "tsc --project tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "peggy": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
